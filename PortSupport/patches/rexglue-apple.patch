+  std::memcpy(point + 1, kOwnerPublic + 8, 64);
+  CFDataRef pub = CFDataCreate(nullptr, point, 65);
+  const void* keys[] = {kSecAttrKeyType, kSecAttrKeyClass};
+  const void* values[] = {kSecAttrKeyTypeECSECPrimeRandom, kSecAttrKeyClassPublic};
+  CFDictionaryRef attrs = CFDictionaryCreate(nullptr, keys, values, 2,
+      &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+  SecKeyRef key = SecKeyCreateWithData(pub, attrs, nullptr);
+  CFRelease(pub); CFRelease(attrs);
+  if (!key) return false;
+  CFDataRef data = CFDataCreate(nullptr, reinterpret_cast<const UInt8*>(message.data()), message.size());
+  CFDataRef signature = CFDataCreate(nullptr, der.data(), der.size());
+  bool ok = SecKeyVerifySignature(key, kSecKeyAlgorithmECDSASignatureMessageX962SHA256, data, signature, nullptr);
+  CFRelease(data); CFRelease(signature); CFRelease(key);
