+void SDLWindowedAppContext::PumpEvents() {
+  SDL_Event event;
+  // A continuously repainting game can replenish this queue while it is
+  // drained. Yield to UIKit after one paint so touch/lifecycle events run.
+  for (int processed = 0; processed < 32 && SDL_PollEvent(&event); ++processed) {
+    const bool painted = event.type == paint_event_type_;
+    ProcessEvent(event);
+    if (painted) break;
+  }
+  ExecutePendingFunctionsFromUIThread();
