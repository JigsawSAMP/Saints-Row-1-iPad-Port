+bool Verify(const std::string& message, const uint8_t sig[64]) {
+  // Windows uses raw r||s; Apple's ECDSA verifier uses an ASN.1 sequence.
+  std::vector<uint8_t> payload;
+  for (int n = 0; n < 2; ++n) {
+    const uint8_t* integer = sig + n * 32;
+    size_t skip = 0;
+    while (skip < 31 && integer[skip] == 0) ++skip;
+    bool pad = (integer[skip] & 0x80) != 0;
+    payload.push_back(0x02);
+    payload.push_back(uint8_t(32 - skip + (pad ? 1 : 0)));
+    if (pad) payload.push_back(0);
+    payload.insert(payload.end(), integer + skip, integer + 32);
+  }
