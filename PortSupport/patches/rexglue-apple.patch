+// The generated memory accesses are volatile, but ARM64 also needs the
+// ordering barriers used by the Xenon job queues. x86-only no-ops can lose
+// wakeups when shared work is published before its data becomes visible.
+static bool build_memory_barrier(BuilderContext& ctx) {
+  ctx.println("#if defined(__aarch64__) || defined(_M_ARM64)");
+  ctx.println("\tstd::atomic_thread_fence(std::memory_order_seq_cst);");
+  ctx.println("#endif");
+  return true;
+}
+bool build_sync(BuilderContext& ctx) { return build_memory_barrier(ctx); }
+bool build_lwsync(BuilderContext& ctx) { return build_memory_barrier(ctx); }
+bool build_eieio(BuilderContext& ctx) { return build_memory_barrier(ctx); }
 
